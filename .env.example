# ---------------------------------------------------------------------------
# Payload
# ---------------------------------------------------------------------------
# Long random string used to sign auth tokens. Generate one per environment.
PAYLOAD_SECRET=your-generated-secret

# Postgres connection string. Works with Neon, Supabase, RDS, or local Postgres.
# Neon (via Vercel Marketplace) provides this value for you.
DATABASE_URL=postgres://user:password@host:5432/dbname

# ---------------------------------------------------------------------------
# Branding (surfaced in metadata, header, and emails)
# ---------------------------------------------------------------------------
COMPANY_NAME="Marisol"
SITE_NAME="Marisol"
TWITTER_CREATOR="@marisol"
TWITTER_SITE="https://marisol.example.com"

# ---------------------------------------------------------------------------
# URLs
# ---------------------------------------------------------------------------
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate draft-preview requests from the admin.
PREVIEW_SECRET=demo-draft-secret

# ---------------------------------------------------------------------------
# Stripe (test keys for local development)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# ---------------------------------------------------------------------------
# Email — pick ONE provider, or neither
# ---------------------------------------------------------------------------
# Leave both blocks empty in development: Payload falls back to an Ethereal test
# inbox and logs its username and password on boot. Sign in at ethereal.email to
# read the reset and confirmation emails. Nothing reaches a real recipient.

# The address customers see. Must be on a domain your provider is allowed to send
# for, or the mail will fail SPF/DKIM and land in spam.
EMAIL_FROM_ADDRESS=hello@yourstore.com
EMAIL_FROM_NAME="Your Store"

# Option A — Resend (HTTP API). Preferred on serverless: one request, no SMTP
# handshake to time out on a cold start. Free tier covers 3,000 emails a month.
RESEND_API_KEY=

# Option B — any SMTP server: the mailbox you already have (Spacemail, Google
# Workspace), or a sending service (Amazon SES, Mailgun, Postmark).
# Port 465 is used as implicit TLS; anything else is treated as STARTTLS.
# Mailbox hosting usually caps at a few hundred messages a day and gives you no
# bounce or delivery log — fine to start, worth outgrowing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Staging safety net: send every message here instead of to the real recipient.
# Set this anywhere the database might hold real customer addresses.
EMAIL_OVERRIDE_RECIPIENT=
